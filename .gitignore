# Most of this folder is written by the Herdr app (AGENTS.md, *.d.ts, icons,
# frame/, the shipped mods and layouts) or holds personal state (shared.json
# caches Linear issues, view.json, window.json, data/, telemetry/). So ignore
# everything and list what's ours.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/package.json
!/tests/
!/keys.json

# Layouts: only our own (shipped ones are Herdr's).
!/layouts/
/layouts/*
!/layouts/main-linear.json

# Mods: only our own. Herdr rewrites the type files and jsconfig on every start.
!/mods/
/mods/*
!/mods/linear-issues/
!/mods/linear-search/
!/mods/tabs-linear/
!/mods/Sketch/
!/mods/spaces-agents/
!/mods/codex-usage/
/mods/*/gpui-kit.d.ts
/mods/*/herdr.d.ts
/mods/*/jsconfig.json
*.error
.DS_Store

/mods/*/__pycache__/

!/mods/new-menu-linear/

!/mods/menu-linear/

# Agent skill for the Sketch worktree boards.
!/skills/

!/mods/files-sketch/

# Personal preferences and the customized agent interface.
!/settings.json
!/programs.json
!/layouts/agent-control-center.json
!/mods/agent-control-center/
!/mods/agent-control-chrome/
!/mods/agent-control-settings/
!/mods/agent-interface-toggle/
!/mods/agent-issue/
!/mods/agent-resume/
!/mods/tab-selection/
!/mods/worktree-codex/
!/mods/worktree-selection/
!/mods/toast/
!/mods/worktree/
**/__pycache__/
*.pyc
