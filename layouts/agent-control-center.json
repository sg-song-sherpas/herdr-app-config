{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "agent-control-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "agent-control-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 376
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-linear"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main-region",
              "type": "column",
              "children": [
                {
                  "id": "acc-context",
                  "type": "block",
                  "content": {
                    "mod": "agent-control-center",
                    "props": {
                      "role": "context"
                    }
                  },
                  "size": {
                    "px": 100
                  }
                },
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ],
              "gap": 8
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files-sketch"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "linear",
                      "type": "column",
                      "children": [
                        {
                          "id": "linear-list",
                          "type": "block",
                          "content": {
                            "mod": "linear-issues"
                          },
                          "size": {
                            "weight": 3
                          },
                          "min": 120
                        },
                        {
                          "id": "linear-detail",
                          "type": "block",
                          "content": {
                            "mod": "linear-issues",
                            "props": {
                              "view": "detail"
                            }
                          },
                          "size": {
                            "weight": 2
                          },
                          "min": 160,
                          "hidden": true
                        }
                      ]
                    },
                    {
                      "id": "acc-attention",
                      "type": "block",
                      "content": {
                        "mod": "agent-control-center",
                        "props": {
                          "role": "attention",
                          "dock": "panel"
                        }
                      },
                      "size": {
                        "weight": 1
                      }
                    }
                  ],
                  "active": "acc-attention"
                }
              ],
              "size": {
                "px": 396
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "codex-usage",
            "props": {
              "status": true
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/agent-control-center.svg"
}
